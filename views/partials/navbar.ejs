<!-- Navbar color switcher (scrolled) -->
<script>
    const navbarEl = document.getElementById('navbar');
    const navLinks = navbarEl.querySelectorAll('.nav-link');
    const logo = document.getElementById('nav-logo');

    window.addEventListener('scroll', () => {
        if (window.scrollY > 80) {
            navbarEl.style.background = 'rgba(255,255,255,0.95)';

            navLinks.forEach(l => {
                l.classList.remove('text-white/90', 'hover:text-white', 'hover:bg-white/10');
                l.classList.add('text-gray-700', 'hover:text-primary-700', 'hover:bg-primary-50');
            });

            logo.querySelectorAll('div').forEach(el => {
                el.classList.remove('text-white', 'text-white/80');
                el.classList.add('text-primary-700');
            });

        } else {
            navbarEl.style.background = 'transparent';

            navLinks.forEach(l => {
                l.classList.add('text-white/90', 'hover:text-white', 'hover:bg-white/10');
                l.classList.remove('text-gray-700', 'hover:text-primary-700', 'hover:bg-primary-50');
            });

            // 🔥 TAMBAHAN INI (fix kamu)
            logo.querySelectorAll('div').forEach(el => {
                el.classList.remove('text-primary-700');
            });

            // set ulang warna awal
            const texts = logo.querySelectorAll('div');
            if (texts[0]) texts[0].classList.add('text-white');
            if (texts[1]) texts[1].classList.add('text-white/80');
        }
    });
</script>
<!-- ===== SLIDE DOTS SCRIPT ===== -->
<script>
  const slidesRef = document.querySelectorAll(' .hero-slide'); const dotsRef = document.querySelectorAll('.dot'); let
    currentSlideRef = 0; function goToSlide(n) {
      slidesRef[currentSlideRef].classList.remove('active');
      dotsRef[currentSlideRef].classList.remove('bg-white/80');
      dotsRef[currentSlideRef].classList.add('bg-white/30'); currentSlideRef = n;
      slidesRef[currentSlideRef].classList.add('active');
      dotsRef[currentSlideRef].classList.add('bg-white/80');
      dotsRef[currentSlideRef].classList.remove('bg-white/30');
    } // Auto - slide with dots sync
  setInterval(() => {
    const next = (currentSlideRef + 1) % slidesRef.length;
    goToSlide(next);
  }, 5000);
</script>
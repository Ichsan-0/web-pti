<!-- ===== PAGE HERO ===== -->
<section
  class="pt-32 pb-16 bg-gradient-to-br from-islamic-dark via-primary-800 to-primary-900 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10"
    style="background-image: radial-gradient(circle at 20% 50%, #4ade80 0%, transparent 60%), radial-gradient(circle at 80% 20%, #22c55e 0%, transparent 50%);">
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex items-center gap-2 text-white/60 text-sm mb-6">
      <a href="/" class="hover:text-white transition-colors">Beranda</a>
      <i class="ph ph-caret-right text-xs"></i>
      <span class="text-white/80">Tentang FTK</span>
      <i class="ph ph-caret-right text-xs"></i>
      <span class="text-white">Struktur Organisasi</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">Struktur Organisasi</h1>
    <p class="text-white/70 text-lg max-w-2xl">Bagan dan susunan organisasi Fakultas Tarbiyah dan Keguruan UIN Ar-Raniry
      Banda Aceh.</p>
  </div>
</section>

<!-- ===== CONTENT ===== -->
<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Bagan Organisasi -->
    <div class="reveal mb-16">
      <div class="text-center mb-12">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold tracking-wider uppercase mb-4">Bagan</span>
        <h2 class="text-3xl font-bold text-gray-900">Struktur Organisasi FTK</h2>
        <p class="text-gray-500 mt-2 text-sm">Susunan kepemimpinan dan unit kerja Fakultas Tarbiyah dan Keguruan.</p>
      </div>

      <!-- Org Chart -->
      <div class="overflow-x-auto pb-4">
        <div class="min-w-[700px]">

          <!-- Level 1: Dekan -->
          <div class="flex justify-center mb-6">
            <div
              class="bg-gradient-to-br from-islamic-dark to-primary-800 text-white rounded-2xl px-8 py-4 text-center shadow-xl min-w-[220px]">
              <div class="text-xs font-bold text-primary-300 mb-1 uppercase tracking-wider">Pimpinan</div>
              <div class="font-bold text-base">Dekan</div>
              <div class="text-xs text-white/70 mt-1">Prof. Safrul Muluk, S.Ag., MA., M.Ed., Ph.D.</div>
            </div>
          </div>

          <!-- Connector -->
          <div class="flex justify-center mb-0">
            <div class="w-0.5 h-6 bg-primary-300"></div>
          </div>
          <div class="flex justify-center mb-0">
            <div class="w-2/3 h-0.5 bg-primary-300"></div>
          </div>

          <!-- Level 2: Wakil Dekan -->
          <div class="flex justify-between gap-4 mb-6 px-4">
            <% const wdList=[ { label: "Wakil Dekan I" , sub: "Akademik & Pengembangan Lembaga" ,
              color: "from-blue-600 to-blue-800" }, { label: "Wakil Dekan II" ,
              sub: "Administrasi, Perencanaan & Keuangan" , color: "from-amber-600 to-amber-800" }, {
              label: "Wakil Dekan III" , sub: "Kemahasiswaan & Kerja Sama" , color: "from-purple-600 to-purple-800" },
              ]; %>
              <% wdList.forEach(function(wd) { %>
                <div class="flex-1 flex flex-col items-center">
                  <div class="w-0.5 h-6 bg-primary-300"></div>
                  <div
                    class="bg-gradient-to-br <%= wd.color %> text-white rounded-xl px-4 py-3 text-center shadow-lg w-full">
                    <div class="font-bold text-xs mb-1">
                      <%= wd.label %>
                    </div>
                    <div class="text-xs text-white/70 leading-tight">
                      <%= wd.sub %>
                    </div>
                  </div>
                </div>
                <% }); %>
          </div>

          <!-- Connector ke bawah -->
          <div class="flex justify-center mb-0">
            <div class="w-0.5 h-6 bg-gray-300"></div>
          </div>

          <!-- Level 3: Bag. TU & Senat -->
          <div class="flex justify-center gap-8 mb-6">
            <div class="flex flex-col items-center">
              <div class="w-0.5 h-0 bg-gray-300"></div>
              <div
                class="bg-white border-2 border-primary-200 text-gray-800 rounded-xl px-6 py-3 text-center shadow-sm min-w-[160px]">
                <div class="text-xs font-bold text-primary-700 mb-1">Senat Fakultas</div>
                <div class="text-xs text-gray-500">Lembaga Pertimbangan</div>
              </div>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-0.5 h-6 bg-gray-300"></div>
              <div
                class="bg-white border-2 border-gray-200 text-gray-800 rounded-xl px-6 py-3 text-center shadow-sm min-w-[160px]">
                <div class="text-xs font-bold text-gray-700 mb-1">Kepala Bagian TU</div>
                <div class="text-xs text-gray-500">Drs. Marzuki, M.Pd</div>
              </div>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-0.5 h-0 bg-gray-300"></div>
              <div
                class="bg-white border-2 border-amber-200 text-gray-800 rounded-xl px-6 py-3 text-center shadow-sm min-w-[160px]">
                <div class="text-xs font-bold text-amber-700 mb-1">Gugus Penjaminan Mutu</div>
                <div class="text-xs text-gray-500">Unit SPMI Fakultas</div>
              </div>
            </div>
          </div>

          <!-- Level 4: Prodi -->
          <div class="mt-4">
            <div class="flex justify-center mb-2">
              <div class="w-0.5 h-6 bg-gray-300"></div>
            </div>
            <div class="bg-primary-50 border border-primary-200 rounded-2xl p-6">
              <p class="text-center text-xs font-bold text-primary-700 uppercase tracking-wider mb-4">Program Studi (14
                Prodi)</p>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
                <% const prodiList=[ "Pendidikan Agama Islam" , "Pendidikan Bahasa Arab" , "Pendidikan Bahasa Inggris"
                  , "Pendidikan Matematika" , "Manajemen Pendidikan Islam" , "Pendidikan Biologi" , "Pendidikan Kimia"
                  , "Pend. Guru MI (PGMI)" , "Pend. Islam AUD (PIAUD)" , "Pend. Teknik Elektro"
                  , "Pend. Teknologi Informasi" , "Bimbingan Konseling" , "Pendidikan Profesi Guru"
                  , "Pendidikan Fisika" , ]; %>
                  <% prodiList.forEach(function(p) { %>
                    <div
                      class="bg-white rounded-lg px-3 py-2 text-xs text-gray-700 font-medium text-center border border-primary-100 shadow-sm">
                      <%= p %>
                    </div>
                    <% }); %>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Unit Pendukung -->
    <div class="reveal">
      <div class="text-center mb-10">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold tracking-wider uppercase mb-4">Unit
          Kerja</span>
        <h2 class="text-3xl font-bold text-gray-900">Unit & Lembaga Pendukung</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <% const units=[ { icon: "book-open" , label: "Lembaga Jurnal Ilmiah" ,
          desc: "Mengelola penerbitan jurnal akademik terakreditasi Sinta." }, { icon: "flask" ,
          label: "Laboratorium Microteaching" , desc: "Fasilitas praktik mengajar bagi calon pendidik." }, {
          icon: "users-three" , label: "Unit Kemahasiswaan" , desc: "Koordinator kegiatan dan organisasi kemahasiswaan."
          }, { icon: "handshake" , label: "Unit Kerja Sama" ,
          desc: "Pengelola MoU dan kemitraan nasional & internasional." }, ]; %>
          <% units.forEach(function(u, i) { %>
            <div class="card-hover reveal bg-white rounded-2xl p-5 border border-gray-100 shadow-sm text-center"
              style="transition-delay: <%= i * 0.1 %>s">
              <div class="w-12 h-12 rounded-xl bg-primary-50 flex items-center justify-center mx-auto mb-4">
                <i class="ph ph-<%= u.icon %> text-2xl text-primary-600"></i>
              </div>
              <h3 class="font-bold text-gray-900 text-sm mb-2">
                <%= u.label %>
              </h3>
              <p class="text-gray-500 text-xs leading-relaxed">
                <%= u.desc %>
              </p>
            </div>
            <% }); %>
      </div>
    </div>

    <!-- Download Bagan -->
    <div class="reveal mt-12 text-center">
      <a href="#"
        class="inline-flex items-center gap-2 px-6 py-3 bg-primary-700 text-white font-semibold rounded-xl hover:bg-primary-800 transition-colors text-sm shadow-lg">
        <i class="ph ph-download-simple"></i>
        Unduh Bagan Struktur Organisasi (PDF)
      </a>
    </div>

  </div>
</section>
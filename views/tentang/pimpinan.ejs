<!-- ===== PAGE HERO ===== -->
<section
  class="pt-32 pb-16 bg-gradient-to-br from-islamic-dark via-primary-800 to-primary-900 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10"
    style="background-image: radial-gradient(circle at 20% 50%, #4ade80 0%, transparent 60%), radial-gradient(circle at 80% 20%, #22c55e 0%, transparent 50%);">
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex items-center gap-2 text-white/60 text-sm mb-6">
      <a href="/" class="hover:text-white transition-colors">Beranda</a>
      <i class="ph ph-caret-right text-xs"></i>
      <span class="text-white/80">Tentang FTK</span>
      <i class="ph ph-caret-right text-xs"></i>
      <span class="text-white">Pimpinan (Dekanat)</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">Pimpinan (Dekanat)</h1>
    <p class="text-white/70 text-lg max-w-2xl">Jajaran pimpinan Fakultas Tarbiyah dan Keguruan UIN Ar-Raniry Banda Aceh
      periode 2023–2027.</p>
  </div>
</section>

<!-- ===== CONTENT ===== -->
<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Dekan -->
    <div class="reveal mb-14">
      <div class="text-center mb-10">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold tracking-wider uppercase mb-4">Pimpinan
          Utama</span>
        <h2 class="text-3xl font-bold text-gray-900">Dekan</h2>
      </div>
      <div class="flex justify-center">
        <div class="card-hover bg-white rounded-3xl overflow-hidden shadow-xl border border-gray-100 max-w-sm w-full">
          <div class="h-52 overflow-hidden">
            <img src="/images/dekan.png" alt="Dekan FTK"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 text-center">
            <div
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-bold mb-3">
              <i class="ph ph-star text-xs"></i> Dekan
            </div>
            <h3 class="font-bold text-gray-900 text-lg mb-1">Prof. Safrul Muluk, S.Ag., MA., M.Ed., Ph.D.</h3>
            <p class="text-gray-500 text-sm mb-4">Dekan Fakultas Tarbiyah dan Keguruan</p>
            <div class="space-y-2 text-left border-t border-gray-100 pt-4">
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <i class="ph ph-graduation-cap text-primary-600"></i>
                <span>Guru Besar Ilmu Pendidikan Islam</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <i class="ph ph-envelope text-primary-600"></i>
                <span>dekan.ftk@ar-raniry.ac.id</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <i class="ph ph-phone text-primary-600"></i>
                <span>(0651) 778543</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Wakil Dekan -->
    <div class="reveal">
      <div class="text-center mb-10">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold tracking-wider uppercase mb-4">Wakil
          Pimpinan</span>
        <h2 class="text-3xl font-bold text-gray-900">Wakil Dekan</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% const wakilDekan=[ { nama: "Prof. Dr. Buhori Muslim, M.Ag." , jabatan: "Wakil Dekan I" ,
          bidang: "Bidang Akademik & Kelembagaan" , img: "/images/news-2.jpg" , email: "wd1.ftk@ar-raniry.ac.id" }, {
          nama: "Dr. Samsul Kamal, S.Pd., M.Pd." , jabatan: "Wakil Dekan II" ,
          bidang: "Bidang Administrasi Umum, Perencanaan & Keuangan" , img: "/images/news-3.jpg" ,
          email: "wd2.ftk@ar-raniry.ac.id" }, { nama: "Dr. Yusran, S.Pd., M.Pd." , jabatan: "Wakil Dekan III" ,
          bidang: "Bidang Kemahasiswaan & Kerja Sama" , img: "/images/news-1.jpg" , email: "wd3.ftk@ar-raniry.ac.id" }
          ]; %>

          <% wakilDekan.forEach(function(wd, i) { %>
            <div class="card-hover reveal bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100"
              style="transition-delay: <%= i * 0.1 %>s">
              <div class="h-44 overflow-hidden">
                <img src="<%= wd.img %>" alt="<%= wd.nama %>"
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="p-5">
                <div
                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-bold mb-3">
                  <%= wd.jabatan %>
                </div>
                <h3 class="font-bold text-gray-900 text-sm mb-1 leading-snug">
                  <%= wd.nama %>
                </h3>
                <p class="text-primary-700 text-xs font-medium mb-3">
                  <%= wd.bidang %>
                </p>
                <div class="space-y-1.5 border-t border-gray-100 pt-3">
                  <div class="flex items-center gap-2 text-xs text-gray-500">
                    <i class="ph ph-envelope text-primary-600"></i>
                    <span>
                      <%= wd.email %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
      </div>
    </div>

    <!-- Tenaga Kependidikan -->
    <div class="reveal mt-14">
      <div class="text-center mb-10">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold tracking-wider uppercase mb-4">Staf
          Dekanat</span>
        <h2 class="text-3xl font-bold text-gray-900">Kepala Bagian & Subbagian</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% const staf=[ { nama: "Drs. Marzuki, M.Pd" , jabatan: "Kepala Bagian Tata Usaha" , icon: "briefcase" }, {
          nama: "Hj. Nurhayati, S.Ag" , jabatan: "Kasubbag Akademik & Kemahasiswaan" , icon: "graduation-cap" }, {
          nama: "Drs. Abdullah, M.M" , jabatan: "Kasubbag Keuangan & Kepegawaian" , icon: "currency-dollar" }, {
          nama: "T. Zulkarnain, S.Kom" , jabatan: "Kasubbag Umum & Perlengkapan" , icon: "wrench" }, ]; %>
          <% staf.forEach(function(s, i) { %>
            <div
              class="card-hover reveal flex items-center gap-4 bg-white rounded-2xl p-4 border border-gray-100 shadow-sm"
              style="transition-delay: <%= i * 0.08 %>s">
              <div class="w-11 h-11 rounded-xl bg-primary-50 flex items-center justify-center flex-shrink-0">
                <i class="ph ph-<%= s.icon %> text-xl text-primary-600"></i>
              </div>
              <div>
                <h4 class="font-bold text-gray-900 text-sm">
                  <%= s.nama %>
                </h4>
                <p class="text-gray-500 text-xs mt-0.5">
                  <%= s.jabatan %>
                </p>
              </div>
            </div>
            <% }); %>
      </div>
    </div>

  </div>
</section>
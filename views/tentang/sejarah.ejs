<!-- ===== PAGE HERO ===== -->
<section class="pt-32 pb-16 bg-gradient-to-br from-islamic-dark via-primary-800 to-primary-900 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10"
    style="background-image: radial-gradient(circle at 20% 50%, #4ade80 0%, transparent 60%), radial-gradient(circle at 80% 20%, #22c55e 0%, transparent 50%);">
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex items-center gap-2 text-white/60 text-sm mb-6">
      <a href="/" class="hover:text-white transition-colors">Beranda</a>
      <i class="ph ph-caret-right text-xs"></i>
      <span class="text-white/80">Tentang FTK</span>
      <i class="ph ph-caret-right text-xs"></i>
      <span class="text-white">Sejarah & Profil</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">Sejarah & Profil</h1>
    <p class="text-white/70 text-lg max-w-2xl">Perjalanan panjang Fakultas Tarbiyah dan Keguruan sejak berdiri hingga menjadi pusat pendidikan Islam terkemuka.</p>
  </div>
</section>

<!-- ===== TIMELINE ===== -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Intro -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-20">
      <div class="reveal">
        <span class="inline-block px-4 py-1.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold tracking-wider uppercase mb-4">Profil Fakultas</span>
        <h2 class="text-3xl font-bold text-gray-900 mb-5">Lebih dari 40 Tahun Mencetak Pendidik Terbaik</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Fakultas Tarbiyah dan Keguruan (FTK) UIN Ar-Raniry Banda Aceh merupakan salah satu fakultas tertua dan terbesar di lingkungan UIN Ar-Raniry. Berdiri sejak tahun 1963, FTK telah berkontribusi besar dalam mencetak tenaga pendidik profesional dan berkualitas untuk Aceh dan Indonesia.
        </p>
        <p class="text-gray-600 leading-relaxed mb-6">
          Dengan lebih dari 25.000 alumni yang tersebar di seluruh Indonesia bahkan mancanegara, FTK terus berkomitmen menghasilkan lulusan yang tidak hanya menguasai ilmu kependidikan secara akademis, namun juga memiliki karakter Islami yang kuat.
        </p>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-primary-50 rounded-2xl p-4 border border-primary-100">
            <div class="text-3xl font-bold text-primary-700 mb-1">1963</div>
            <div class="text-xs text-gray-600">Tahun Berdiri</div>
          </div>
          <div class="bg-primary-50 rounded-2xl p-4 border border-primary-100">
            <div class="text-3xl font-bold text-primary-700 mb-1">14</div>
            <div class="text-xs text-gray-600">Program Studi</div>
          </div>
          <div class="bg-primary-50 rounded-2xl p-4 border border-primary-100">
            <div class="text-3xl font-bold text-primary-700 mb-1">25rb+</div>
            <div class="text-xs text-gray-600">Total Alumni</div>
          </div>
          <div class="bg-primary-50 rounded-2xl p-4 border border-primary-100">
            <div class="text-3xl font-bold text-primary-700 mb-1">5400+</div>
            <div class="text-xs text-gray-600">Mahasiswa Aktif</div>
          </div>
        </div>
      </div>
      <div class="reveal reveal-delay-1">
        <img src="/images/hero-bg.jpg" alt="Kampus FTK" class="w-full h-80 object-cover rounded-3xl shadow-2xl" />
      </div>
    </div>

    <!-- Timeline Sejarah -->
    <div class="reveal">
      <div class="text-center mb-14">
        <span class="inline-block px-4 py-1.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold tracking-wider uppercase mb-4">Tonggak Sejarah</span>
        <h2 class="text-3xl font-bold text-gray-900">Perjalanan FTK</h2>
      </div>

      <div class="relative">
        <!-- Garis tengah -->
        <div class="absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-0.5 bg-primary-100 hidden lg:block"></div>

        <div class="space-y-10">

          <% const sejarah = [
            { tahun: "1963", judul: "Pendirian Fakultas Tarbiyah", desc: "Fakultas Tarbiyah didirikan sebagai bagian dari IAIN Ar-Raniry Banda Aceh, sebagai respons terhadap kebutuhan tenaga pendidik agama Islam di Aceh dan sekitarnya.", kiri: true },
            { tahun: "1978", judul: "Pengembangan Program Studi", desc: "Penambahan beberapa program studi baru di bidang kependidikan Islam, memperluas cakupan dan kapasitas fakultas dalam mencetak tenaga pendidik berkualitas.", kiri: false },
            { tahun: "1997", judul: "Transformasi Kurikulum", desc: "Pembaruan kurikulum besar-besaran untuk menyesuaikan dengan kebutuhan dunia pendidikan modern, mengintegrasikan teknologi dalam proses pembelajaran.", kiri: true },
            { tahun: "2004", judul: "Perubahan IAIN menjadi UIN", desc: "Seiring transformasi IAIN Ar-Raniry menjadi UIN Ar-Raniry, Fakultas Tarbiyah berkembang menjadi Fakultas Tarbiyah dan Keguruan (FTK) dengan mandat yang lebih luas.", kiri: false },
            { tahun: "2015", judul: "Akreditasi Institusional Unggul", desc: "FTK berhasil meraih akreditasi institusional dengan peringkat A (Unggul) dari BAN-PT, mengukuhkan posisinya sebagai salah satu fakultas kependidikan terbaik di Indonesia.", kiri: true },
            { tahun: "2024", judul: "14 Prodi Terakreditasi Unggul", desc: "Seluruh 14 program studi di FTK berhasil meraih akreditasi Unggul dan Baik Sekali, menjadikan FTK sebagai benchmark pendidikan keguruan berbasis Islam di Indonesia.", kiri: false },
          ]; %>

          <% sejarah.forEach(function(item, i) { %>
          <div class="relative flex items-start gap-8 <%= item.kiri ? 'lg:flex-row' : 'lg:flex-row-reverse' %>">
            <!-- Dot -->
            <div class="hidden lg:flex absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-primary-700 border-4 border-white shadow-lg items-center justify-center z-10">
              <i class="ph ph-clock text-white text-sm"></i>
            </div>
            <!-- Content -->
            <div class="lg:w-1/2 <%= item.kiri ? 'lg:pr-14' : 'lg:pl-14' %>">
              <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                <span class="inline-block px-3 py-1 rounded-full bg-primary-700 text-white text-xs font-bold mb-3"><%= item.tahun %></span>
                <h3 class="font-bold text-gray-900 text-base mb-2"><%= item.judul %></h3>
                <p class="text-gray-500 text-sm leading-relaxed"><%= item.desc %></p>
              </div>
            </div>
            <div class="lg:w-1/2"></div>
          </div>
          <% }); %>

        </div>
      </div>
    </div>

  </div>
</section>
